APP_ENV=development
APP_HOST=127.0.0.1
API_PORT=8000
UI_PORT=7860
UI_API_BASE_URL=http://127.0.0.1:8000
DATA_DIR=data

CHAT_MODEL=your-chat-model
CHAT_BASE_URL=https://your-chat-endpoint/v1
CHAT_API_KEY=your-chat-api-key

EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_CHECK_CTX_LENGTH=false

QDRANT_MODE=local
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=document_chunks
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

GRAPH_MODE=local
GRAPH_PATH=data/graph/knowledge.db

# 将 GRAPH_MODE 改为 neo4j 后启用；本地开发可使用 compose.neo4j.yaml。
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-password
NEO4J_DATABASE=neo4j

MEMORY_PATH=data/memory/conversations.db
CATALOG_PATH=data/catalog.db
JOBS_PATH=data/jobs.db

TAVILY_API_KEY=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-kg-rag

# 可选：仅在用户主动选择复杂文档增强解析时使用。
MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net
